{
  "repository": "nuxtjp/nuxt-identity-client",
  "purpose": "ログイン、アカウント、認証方法、登録端末の画面を共通化できます。 / Provide consistent sign-in, account, authenticator and device-management screens in a Nuxt service.",
  "responsibility_boundary": "Own the documented Nuxt/browser interface and its public contracts. Account authority, external effects, product state and production hosting remain explicit consumer responsibilities.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@nuxtjp/identity-client",
      "ecosystem": "npm",
      "description": "Provider-neutral identity UI and OIDC BFF security primitives for Nuxt",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./core": {
            "types": "./dist/runtime/core/index.d.ts",
            "import": "./dist/runtime/core/index.js"
          }
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build": "nuxt-module-build build && nuxt build playground",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run && pnpm run test:dependency-security",
        "prepack": "pnpm run build",
        "test:dependency-security": "node --test scripts/dependency-security.check.cjs"
      }
    }
  ],
  "schema_definitions": [],
  "test_sources": [
    "src/runtime/core/bff.ts",
